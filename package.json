  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.10.2",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "ai": "5.0.68",
    "tailwindcss": "4.1.13",
    "typescript": "5.7.3",
    "zod": "3.25.76"
